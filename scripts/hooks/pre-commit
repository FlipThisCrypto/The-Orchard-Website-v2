#!/bin/sh
# The gate, before the commit exists rather than after.
#
# Install:  git config core.hooksPath scripts/hooks
# Skip once (deliberately, and it will say so):  git commit --no-verify
#
# This exists because "run the tests before you push" on the honour system
# failed in the most instructive way possible: the tests WERE run, inside a
# shell chain that gated on `grep` finding output rather than on the output
# saying "fail 0". The commit landed red and CI found it afterwards. A gate
# you can pass while failing is not a gate.
#
# What runs is NOT restated here — it lives in scripts/checks.mjs, shared with
# CI. When it was written out in shell here and again in YAML there, the two
# drifted, and the check neither of them ran (the secrets scan) was the one
# that broke. --fast is the quick tier; CI runs the slow ones too, so a commit
# is never blocked for 20 seconds on a full-history scan.
set -e

echo "pre-commit: running the fast checks…"

node scripts/checks.mjs --fast || {
  echo "  Full set (what CI runs): node scripts/checks.mjs"
  exit 1
}
