# Response headers for worldview.theorchard.network (Cloudflare Pages reads this
# file from the deployed output root). Covered by tests/headers.test.mjs.
#
# Why this page in particular: it is served from the theorchard.network zone so
# it shares the wallet session cookie, and it loads the Connect Wallet widget
# from oracle.theorchard.network. Anything that can frame it, sniff it, or
# redirect its requests is a wallet-adjacent risk, not just a website risk.

/*
  # Clickjacking. A page with a Connect Wallet button must not be frameable by
  # a third party who can overlay it and harvest the click. First-party
  # embedding (theorchard.network and its subdomains) is still allowed.
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: frame-ancestors 'self' https://theorchard.network https://*.theorchard.network; object-src 'none'; base-uri 'self'; form-action 'none'; script-src 'self' https://oracle.theorchard.network https://esm.sh 'sha256-UxvLkQbEJoSFEwy4qRJdb57u7zhybimj0zf3HiQqih8='
  # script-src is now ENFORCED, and it is on the line above — appended by
  # scripts/csp.mjs, which derives the inline-script hash from the page. Never
  # edit that hash by hand; a wrong one blocks the page's own boot script.
  #
  # It was report-only with 'unsafe-inline' for several iterations, which is a
  # policy that does nothing twice over: report-only blocks nothing, and no
  # reporting endpoint was ever configured so nothing was collected either.
  # 'unsafe-inline' is the exact permission that makes CSP useless against
  # injected script, which is the threat this origin actually has.
  #
  # esm.sh stays because connect.js dynamically imports @walletconnect/
  # sign-client and /modal from it at click time — verified by reading the
  # deployed widget, not assumed. Dropping it breaks connecting a wallet.

  # Don't let a response be re-interpreted as a type it isn't.
  X-Content-Type-Options: nosniff

  # Never leak the full URL to other origins.
  Referrer-Policy: strict-origin-when-cross-origin

  # The privacy contract says precise GPS never enters any public path. Make
  # that structural: this page cannot even ask the browser for a location.
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=(), serial=(), midi=()

  # Isolate the browsing context, but keep popups working — some wallets
  # complete the connect flow in one.
  Cross-Origin-Opener-Policy: same-origin-allow-popups

# The vendored engine and texture are ~2.4 MB, so a repeat visit should pay
# nothing for them. Deliberately NOT `immutable` and not a year: these
# filenames carry no content hash, so a client that cached an old copy has no
# way to be told about a new one. 30 days is the ceiling on how long a vendor
# update can take to reach everyone. If you ever need it sooner, rename the
# file — don't lengthen this.
/vendor/*
  Cache-Control: public, max-age=2592000

# The page itself must never be stale after a deploy.
/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/orchard-data.js
  Cache-Control: public, max-age=0, must-revalidate

/app.js
  Cache-Control: public, max-age=0, must-revalidate
